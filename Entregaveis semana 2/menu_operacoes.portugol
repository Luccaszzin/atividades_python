// Versão em Portugol do menu de operações matemáticas.
programa
{
    funcao inicio()
    {
        inteiro opcao
        real primeiro_numero
        real segundo_numero

        escreva("1 - Somar\n2 - Subtrair\n3 - Multiplicar\n4 - Dividir\n")
        escreva("Escolha uma operação: ")
        leia(opcao)
        escreva("Digite o primeiro número: ")
        leia(primeiro_numero)
        escreva("Digite o segundo número: ")
        leia(segundo_numero)

        // escolha/caso tem a mesma ideia de match/case no Python.
        escolha (opcao) {
            caso 1:
                escreva("Resultado da soma: ", primeiro_numero + segundo_numero)
                pare
            caso 2:
                escreva("Resultado da subtração: ", primeiro_numero - segundo_numero)
                pare
            caso 3:
                escreva("Resultado da multiplicação: ", primeiro_numero * segundo_numero)
                pare
            caso 4:
                se (segundo_numero == 0) {
                    escreva("Erro: não é possível dividir por zero.")
                } senao {
                    escreva("Resultado da divisão: ", primeiro_numero / segundo_numero)
                }
                pare
            caso contrario:
                escreva("Opção inválida.")
        }
    }
}
